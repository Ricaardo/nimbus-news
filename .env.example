# ============================================
# 投资信息平台 - 环境变量配置
# ============================================
# 使用方式: 复制此文件为 .env 并修改配置
#   cp .env.example .env
# ============================================

# 服务端口
FRONTEND_PORT=80
BACKEND_API_PORT=8081
WEBHOOK_PORT=8080
WXOFFICIAL_PORT=8082

# 时区
TZ=Asia/Shanghai

# ============================================
# 飞书配置
# ============================================
# 飞书群推送 Webhook
# FEISHU_PUSH_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# 飞书应用凭证 (双向交互机器人)
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_ENCRYPT_KEY=xxx
# FEISHU_VERIFICATION_TOKEN=xxx

# ============================================
# 企业微信配置
# ============================================
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ============================================
# 微信公众号配置
# ============================================
# WXOFFICIAL_APP_ID=xxx
# WXOFFICIAL_APP_SECRET=xxx
# WXOFFICIAL_TOKEN=xxx

# ============================================
# Telegram 配置
# ============================================
# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_CHAT_ID=xxx

# ============================================
# Discord 配置
# ============================================
# DISCORD_PUSH_WEBHOOK=https://discord.com/api/webhooks/xxx
# DISCORD_BOT_TOKEN=xxx
# 多 webhook 轮询分散推送（discord-webhook 渠道，规避单 webhook 频控）
# DISCORD_WEBHOOK_1=https://discord.com/api/webhooks/xxx
# DISCORD_WEBHOOK_2=https://discord.com/api/webhooks/xxx
# DISCORD_WEBHOOK_3=https://discord.com/api/webhooks/xxx

# ============================================
# AI/LLM 配置
# ============================================
# MiniMax API
# MINIMAX_API_KEY=sk-cp-xxx

# DeepSeek API
# DEEPSEEK_API_KEY=sk-xxx

# 通用交易机器人环境变量（可选）
# LLM_PROVIDER=minimax
# LLM_API_URL=https://api.minimax.com/anthropic
# LLM_API_KEY=${MINIMAX_API_KEY}
# LLM_MODEL=MiniMax-M2.5
# LLM_REASONER=MiniMax-M2.5

# 富途 OpenD 辅助脚本路径（默认 scripts/futu_helper.py）
# FUTU_HELPER_PATH=scripts/futu_helper.py

# ============================================
# 数据源 API Keys
# ============================================
# Finnhub - 注册: https://finnhub.io/ (免费)
# FINNHUB_API_KEY=xxx

# FRED (Federal Reserve Economic Data) - 注册: https://fred.stlouisfed.org/ (免费)
# FRED_API_KEY=xxx

# BlockBeats 日报脚本（不要放入 config.platform.yaml 的 command）
BLOCKBEATS_API_KEY=

# Longbridge OpenAPI - 持牌行情 adapter（港股/A股/美股，优先级最高）
# 申请: https://open.longportapp.com/ → 创建应用，需 longport Python SDK (pip install longport)
# 三件套缺任一则 LongbridgeAdapter 静默让位 futu/akshare
# LONGPORT_APP_KEY=xxx
# LONGPORT_APP_SECRET=xxx
# LONGPORT_ACCESS_TOKEN=xxx
