<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.news.feed-pull.plist — 每分钟从 VPS 拉取 news feed 文件到 Mac 原路径。
  2026-08-15 部署: news 平台整体迁往 VPS 后,breaking.jsonl 桥接保持不中断。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.news.feed-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/x/nimbus-os/news/deploy/pull-feed.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/x/nimbus-os/news/logs/feed-pull.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/x/nimbus-os/news/logs/feed-pull.err.log</string>
</dict>
</plist>
